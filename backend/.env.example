# Copy to .env and adjust as needed.
# Homebrew PostgreSQL 16 on port 5433 (trust auth, superuser = macOS user).
DATABASE_URL=postgresql+asyncpg://pizza@localhost:5433/pizza

# JWT signing. Generate a real one: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-in-real-env
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS origins for the Vite dev server.
CORS_ORIGINS=http://localhost:5173

# Default budgeting rules (editable per user via BudgetSettings).
DEFAULT_SAVINGS_PCT=0.60
DEFAULT_RETIREMENT_401K_PCT=0.01
DEFAULT_HSA_PER_CYCLE=50.00
